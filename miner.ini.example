[account]
# Leave empty to be prompted on first run; or set your 0x wallet here
address =
# Leave empty on first run to be prompted, or type Enter for auto
# xnminer-a1b2c3d4. Or set a custom name here anytime.
worker =

[server]
base_url = http://xenblocks.io
connection_timeout_s = 20
network_poll_interval_s = 15
network_poll_timeout_s = 3
network_down_poll_interval_s = 30

[mining]
# cuda = native GPU | cpu = no NVIDIA | gpu = legacy xenblocks.exe bridge
backend = cuda
strategy = random
memory_cost = 1100
time_cost = 1
parallelism = 1
hash_len = 64

[efficiency]
# VRAM safety as % of EACH GPU's total (auto-scales for all card sizes)
# ~24 GiB used on a 32 GiB 5090 FE ≈ 73.5% — override with target_vram_mib if preferred
target_vram_pct = 73.50
desktop_headroom_pct = 22.00
emergency_vram_pct = 92.78
min_headroom_pct = 3.68
runtime_overhead_pct = 6.28
min_headroom_floor_mib = 512
runtime_overhead_floor_mib = 256
# Absolute MiB overrides (0 = use percentages only). 24576 ≈ 24 GiB TOTAL used cap
# (desktop + miner). With vram_account_desktop=true, batch shrinks for DWM/Chrome.
target_vram_mib = 24576
headroom_mib = 0
emergency_vram_mib = 0
min_headroom_mib = 0
# Subtract Windows desktop / background VRAM from the mining budget (display GPU).
vram_account_desktop = true
# Extra pad for allocator fragmentation / estimate error
vram_safety_margin_mib = 512
# Soft reel-in when used creeps above target — keep mining, shrink batch/lanes
vram_soft_derate_enabled = true
vram_soft_min_scale = 0.55
vram_soft_lane_enabled = true
# Die (GPU) temps — tighter than board
max_gpu_temp_c = 84
warn_gpu_temp_c = 78
# Board / PCB — Tony measured ~88C sustained week; hard stop 90
max_board_temp_c = 90
warn_board_temp_c = 85
gpu_cooldown_s = 60
gpu_power_boost_enabled = true
# Power: max clocks at low dif (100), slope toward min as dif + board heat rise
gpu_power_target_pct = 100
gpu_power_min_pct = 65
gpu_difficulty_power_enabled = true
gpu_difficulty_power_full_ratio = 1.9
# Clock curve + max-lanes harvest for low dif
# At dif <= 100: full VRAM budget + MAX lanes possible for best speeds
# (user: lanes do not raise board temps at low dif; temps rise with dif >100)
# As dif rises: curve slopes power, fill, and lanes down (stays under board 90C cap)
clock_curve_enabled = true
clock_low_difficulty = 100
clock_batch_fill_low = 1.0
clock_batch_fill_ref = 0.95
clock_batch_fill_high = 0.85
# Soft-shrink CUDA batch as temp nears warn/max (never below min scale)
gpu_thermal_batch_enabled = true
gpu_thermal_batch_min_scale = 0.60
# Live multi-lane shrink when the board warms (before hard stop)
gpu_thermal_lane_enabled = true
gpu_thermal_lane_min = 1
# As difficulty climbs toward reference, bias lanes down early
gpu_difficulty_lane_bias = true
gpu_difficulty_lane_full_pack_ratio = 0.35
# High-diff board proxy only when board sensor is missing (die looks cool).
gpu_high_diff_temp_enabled = true
gpu_high_diff_temp_start_ratio = 1.5
gpu_high_diff_temp_full_ratio = 1.9
gpu_high_diff_temp_max_tighten_c = 12
gpu_windows_performance_mode = true
cpu_lanes = 2
lane_ramp_step = 1
sample_interval_s = 5

[queue]
db_path = data/blocks.db
jsonl_path = data/queue.jsonl
rejected_jsonl_path = data/rejected.jsonl
submit_cpu_fraction = 0.30

[monitoring]
log_path = data/session.log
timelapse_path = data/session_timelapse.jsonl
stats_interval_s = 4
timelapse_sample_s = 30
temp_watch_path = data/temp_watch.log
dashboard_enabled = true
# X1 RPC for wallet balance panel (comma-separated fallbacks). eth_call can be slow.
wallet_rpc_url = https://xenblocks.io:5556,https://xenblocks.io:5555
woodyminer_enabled = true
woodyminer_upload_url = https://woodyminer.com/api/stat/upload
woodyminer_upload_period_s = 60
# Shown on woodyminer.com leaderboard. Leave empty for auto unique name
# (same as worker on first run). Set your own label anytime.
woodyminer_custom_name =
# Share accepts + holdings with XenBlockScan (http://127.0.0.1:8787 by default)
xenblockscan_enabled = false
xenblockscan_endpoint = http://127.0.0.1:8787/api/v1/events
xenblockscan_api_key =
xenblockscan_report_rejects = false
# How often to push live hashrate + balances to the site (seconds)
xenblockscan_holdings_interval_s = 30
# Optional deferred history only; default off so mining never waits on the site
xenblockscan_backfill = false
# Unique fleet tracker id for this machine (auto-generated if empty)
tracker_id =

[gpu]
# Only used if backend = gpu (legacy). Leave empty for cuda/cpu.
xenblocks_exe =
xenblocks_db =
enabled = false

[cuda]
# Windows: native/build/bin/xen_cuda.dll
# Linux:   native/build/bin/libxen_cuda.so  (auto-resolved if this path is missing)
dll_path = native/build/bin/xen_cuda.dll
batch_size = 0
max_batch_size = 0
# Dense low-dif harvest
# max_lanes matters when native multi-lane OR lane_pack_mode=coverage.
# Sequential Win11 default: 1 full VRAM stream (best H/s). Multi-lane needs
# native xen_cuda_set_lane_count or allow_dll_lane_copies=true.
max_lanes = 8
lane_reserve = 1
# fill = VRAM-first (1 stream if sequential; multi if parallel native)
# coverage = sequential multi key-prefix sweep (not faster H/s)
# boost = legacy reference//difficulty lane count when parallel
lane_pack_mode = fill
min_batch_per_lane = 2048
# false = sequential single-stream (safe, best H/s without native multi-lane)
allow_dll_lane_copies = false
# 0 = use efficiency.runtime_overhead_pct of GPU total
runtime_overhead_mib = 0
